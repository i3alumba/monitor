# Non-secret configuration only. Install as /etc/public-page-monitor/agent.env.
MONITOR_NODE=alpha
MONITOR_ENDPOINT=https://monitor-collector.public-page.svc.cluster.local:8443/v1/samples
# Replace with the assigned private Service IP, not a public ingress address.
MONITOR_SERVER_IP=10.43.0.100
MONITOR_CA_FILE=/etc/public-page-monitor/ca.crt
MONITOR_INTERVAL_SECONDS=10
# Native sandbox paths: operator binds only verified empty probes to these targets.
MONITOR_FILESYSTEMS_JSON='{"root":"/run/monitor-probes/root","hdd":"/run/monitor-probes/hdd"}'
# Set observed physical NIC names explicitly. Empty means no network metrics.
MONITOR_INTERFACES=
