[Unit]
Description=Public Page native host telemetry (outbound only)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
DynamicUser=yes
EnvironmentFile=/etc/public-page-monitor/agent.env
LoadCredential=token:/etc/public-page-monitor/token
Environment=MONITOR_TOKEN_FILE=%d/token
ExecStart=/usr/local/bin/resource-monitor agent
Restart=on-failure
RestartSec=10
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
LockPersonality=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallArchitectures=native
UMask=0077
MemoryMax=128M
TasksMax=32
CPUQuota=15%
# Operator must bind only verified empty root/HDD probes, not their data roots.
# Add host-specific BindReadOnlyPaths=source-root-probe:/run/monitor-probes/root
# and BindReadOnlyPaths=source-hdd-probe:/run/monitor-probes/hdd drop-ins.
# Override MONITOR_FILESYSTEMS_JSON to these /run targets (see agent.env.example).

[Install]
WantedBy=multi-user.target
